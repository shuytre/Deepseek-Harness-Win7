# Windows 7 SP1 x64 build environment (copy to .env.win7, Git ignored).
# Read by `pnpm build:win7` -> apps/desktop/win7/build-win7.mjs.
# The Win7 track runs from .env.windows too; this file documents only what differs.

# Track switch read by every Desktop build step. Keep it 1 for the Win7 track.
DSH_TARGET_WIN7=1

# Target selectors. Win7 is x64 only.
DSH_DESKTOP_TARGET_PLATFORM=win32
DSH_DESKTOP_TARGET_ARCH=x64

# Unsigned by default: the Win7 track ships no update feed, so a signed build is
# only needed for distribution. `--signed` on the command line overrides this.
DSH_DESKTOP_UNSIGNED=1

# Application identity. Keep the Win10 track's value so both tracks install and
# uninstall as the same product.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Module roots the node:sqlite shim resolves its driver from. The orchestrator
# sets this automatically; override only for a non-standard layout.
# DSH_WIN7_MODULE_ROOTS=

# Absolute path to the compatibility runtime. The orchestrator sets this from
# the prepared payload; override only for debugging a packaged installation.
# DSH_WIN7_COMPAT_DIR=

# Optional: pnpm's JS entry when the host has no working standalone pnpm.
#   npm i pnpm@11.28.5 --prefix C:\tools\pnpm-js
# PNPM_CJS=C:\tools\pnpm-js\node_modules\pnpm\bin\pnpm.cjs

# Signing (only with --signed). Same four values the Win10 track uses.
# DSH_DESKTOP_WINDOWS_CER_FILE=
# DSH_DESKTOP_WINDOWS_SIGNTOOL=
# DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
# DSH_DESKTOP_WINDOWS_TOKEN_PIN=
